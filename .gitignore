# markdown 依赖的隔离安装目录（用 `python -m pip install --target _build_vendor markdown` 生成）
_build_vendor/
# Python 缓存
__pycache__/
*.pyc
# 系统杂项
Thumbs.db
.DS_Store
desktop.ini
# Leno 编译缓存（在本目录跑 leno.exe 时生成，如 import_module_docs.leno）
.lenocache/
# 站点构建失败时的备份（成功会自删；失败留着可回滚）
site.bak/
# build_html.leno 的对照产物（用 Leno 版构建到独立目录，和 py 版逐页比）
site_leno/
