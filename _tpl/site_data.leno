// site_data.leno —— 由 build_html.py 一次性抽出的**数据表**（分类 / 显示名 / 首页快捷卡）。
// 生成后它就是唯一事实来源：改分类请改这里，build_html.leno 只读不写。

// 一个分类：名称 / 首页是否折叠 / 一句话说明 / 归类规则（文件名，或 PREFIX: / SUFFIX: 前缀式）
export struct Cat {
    string name = ""
    bool fold = false
    string desc = ""
    Array[string] rules = []
}

func cat(string name, bool fold, string desc, Array[string] rules):Cat {
    Cat c = new Cat()
    c.name = name
    c.fold = fold
    c.desc = desc
    c.rules = rules
    return c
}

